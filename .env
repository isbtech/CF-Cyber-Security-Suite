NODE_ENV=development
PORT=3001

# JWT Secrets
JWT_SECRET=your-secret-key-here-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-here-change-in-production

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:3001

# Database Settings (if using real database)
DATABASE_URL=sqlite:prophetic_prayer.db

# File Upload Settings
UPLOAD_MAX_SIZE=5242880
UPLOAD_DEST=uploads/

# WebSocket Settings
WS_PORT=3002

# External Services (if needed)
PUSH_NOTIFICATION_KEY=your-push-notification-key
EMAIL_SERVICE_KEY=your-email-service-key
VIDEO_CDN_URL=https://cdn.propheticprayer.com

# Admin Settings
ADMIN_EMAIL=admin@propheticprayer.com
ADMIN_PASSWORD=change-this-password

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5